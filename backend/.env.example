PORT=8787
HOST=0.0.0.0
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Set true only for demo testing.
TM_API_MOCK=true

# TaxiMaster 3.16 CommonAPI
TM_API_BASE_URL=https://192.168.1.254:8089/common_api/1.0
TM_API_USER_ID=5
TM_API_SECRET=PUT_THE_NEW_SECRET_HERE

# If TaxiMaster uses a self-signed certificate on your protected LAN,
# set false temporarily. Prefer trusting the certificate instead.
TM_API_VERIFY_TLS=false
TM_API_TIMEOUT_MS=12000

TM_DEFAULT_CITY=
TM_ADDRESS_SEARCH_TM=true
TM_ADDRESS_SEARCH_TMGEO=false
TM_ADDRESS_SEARCH_2GIS=false


# LIVE tariff mapping. Defaults match the verified TaxiMaster configuration.
TM_CREW_GROUP_START_ID=2
TM_CREW_GROUP_COMFORT_ID=3
TM_CREW_GROUP_BUSINESS_ID=4
TM_CREW_GROUP_DELIVERY_ID=16
TM_CREW_GROUP_CARGO_ID=15
TM_TARIFF_DELIVERY_ID=27
TM_TARIFF_CARGO_ID=28

# Together is calculated from the current LIVE Start price.
# Change this value on the backend without rebuilding the APK.
YANGI_TOGETHER_DISCOUNT_PERCENT=18
